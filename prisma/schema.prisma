generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                  @id @default(autoincrement())
  email                 String               @unique
  password              String
  name                  String?
  role                  Role                 @default(user)
  emailVerified         Boolean              @default(false)
  clubId                Int?                 @map("club_id")
  tariffId              Int?                 @map("tariff_id")
  startDate             DateTime?            @map("start_date")
  endDate               DateTime?            @map("end_date")
  paid                  Boolean?             @default(false)
  paidAt                DateTime?            @map("paid_at")
  position              String?
  hiredAt               DateTime?            @map("hired_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  trainerId             Int?                 @map("trainer_id")
  attendanceRecords     Attendance[]
  balance               Balance?
  password_reset_tokens PasswordResetToken[]
  pushSubscriptions     PushSubscription[]
  reviews               Review[]
  transactions          Transaction[]
  club                  Club?                @relation(fields: [clubId], references: [id])
  tariff                Tariff?              @relation(fields: [tariffId], references: [id])
  workoutsAsTrainer     Workout[]            @relation("TrainerWorkouts")

  @@map("users")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Club {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  address      String
  phone        String?
  email        String?
  description  String?
  logo         String?
  status       ClubStatus @default(active)
  workingHours Json?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  city         String?
  images       String[]   @default([])
  reviews      Review[]
  tariffs      Tariff[]
  users        User[]
  workouts     Workout[]

  @@map("clubs")
}

model Tariff {
  id        Int        @id @default(autoincrement())
  clubId    Int        @map("club_id")
  name      String
  type      TariffType
  price     Float
  duration  Int?
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  club      Club       @relation(fields: [clubId], references: [id])
  users     User[]

  @@unique([clubId, name])
  @@map("tariffs")
}

model Balance {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  amount    Float    @default(100)
  currency  String   @default("BYN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("balances")
}

model Transaction {
  id           Int             @id @default(autoincrement())
  userId       Int             @map("user_id")
  type         TransactionType
  amount       Float
  balanceAfter Float           @map("balance_after")
  tariffId     Int?            @map("tariff_id")
  clubId       Int?            @map("club_id")
  description  String?
  createdAt    DateTime        @default(now()) @map("created_at")
  user         User            @relation(fields: [userId], references: [id])

  @@map("transactions")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

model Workout {
  id                  Int           @id @default(autoincrement())
  clubId              Int
  trainerId           Int
  title               String
  description         String?
  startTime           DateTime
  endTime             DateTime
  maxParticipants     Int
  currentParticipants Int           @default(0)
  status              WorkoutStatus @default(scheduled)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  attendance          Attendance[]
  club                Club          @relation(fields: [clubId], references: [id])
  trainer             User          @relation("TrainerWorkouts", fields: [trainerId], references: [id])

  @@map("workouts")
}

model Attendance {
  id           Int              @id @default(autoincrement())
  workoutId    Int
  userId       Int
  status       AttendanceStatus @default(registered)
  registeredAt DateTime         @default(now())
  attendedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id])
  workout      Workout          @relation(fields: [workoutId], references: [id])

  @@map("attendance")
}

model Review {
  id          Int      @id @default(autoincrement())
  clubId      Int
  userId      Int
  rating      Int
  comment     String?
  isModerated Boolean  @default(false)
  moderatedBy Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  club        Club     @relation(fields: [clubId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@map("reviews")
}

enum Role {
  super_admin
  club_admin
  trainer
  member
  user
}

enum ClubStatus {
  active
  inactive
  closed
}

enum TariffType {
  single
  monthly
  quarterly
  yearly
}

enum TransactionType {
  deposit
  payment
  failed_payment
  refund
}

enum WorkoutStatus {
  scheduled
  ongoing
  completed
  cancelled
}

enum AttendanceStatus {
  registered
  confirmed
  attended
  cancelled
  no_show
}
